<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <op:config name="%SLED_NumChannelsDefault%" value="%N%" />

  <op:config name="%SLEDdefaultName1%" value=""></op:config>
  <op:config name="%SLEDdefaultMode1%" value="1"></op:config>
  <op:config name="%SLEDdefaultFunc1%" value="0"></op:config>
  <op:config name="%SLEDdefaultType1%" value="1"></op:config>

  <op:config name="%SLEDdefaultName2%" value=""></op:config>
  <op:config name="%SLEDdefaultMode2%" value="1"></op:config>
  <op:config name="%SLEDdefaultFunc2%" value="0"></op:config>
  <op:config name="%SLEDdefaultType2%" value="1"></op:config>

  <op:config name="%SLEDdefaultName3%" value=""></op:config>
  <op:config name="%SLEDdefaultMode3%" value="1"></op:config>
  <op:config name="%SLEDdefaultFunc3%" value="0"></op:config>
  <op:config name="%SLEDdefaultType3%" value="1"></op:config>

  <op:config name="%SLEDdefaultName4%" value=""></op:config>
  <op:config name="%SLEDdefaultMode4%" value="1"></op:config>
  <op:config name="%SLEDdefaultFunc4%" value="0"></op:config>
  <op:config name="%SLEDdefaultType4%" value="1"></op:config>

  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <ParameterTypes>
              <ParameterType Id="%AID%_PT-SLEDNumChannels" Name="SLEDNumChannels">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="%N%" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-SLEDType" Name="SLEDType">
                <TypeRestriction Base="Value" SizeInBit="4" UIHint="DropDown">
                  <Enumeration Text="einfarbig" Value="1" Id="%ENID%" DisplayOrder="1" />
                  <Enumeration Text="RGB" Value="2" Id="%ENID%" DisplayOrder="2" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-SLEDMode" Name="SLEDMode">
                <TypeRestriction Base="Value" SizeInBit="4" UIHint="DropDown">
                  <Enumeration Text="LED-Funktion" Value="1" Id="%ENID%" DisplayOrder="1"/>
                  <Enumeration Text="Steuerung über KO" Value="2" Id="%ENID%" DisplayOrder="2"/>
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-SLEDEffect" Name="SLEDEffect">
                <TypeRestriction Base="Value" SizeInBit="32" UIHint="DropDown">
                  <Enumeration Text="kein Effekt" Value="0" Id="%ENID%" />
                  <Enumeration Text="Blinken" Value="1" Id="%ENID%" />
                  <Enumeration Text="Pulsieren" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-SLEDKoControlType" Name="SLEDKoControlType">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="Deaktiviert" Value="0" Id="%ENID%"/>
                  <Enumeration Text="ändern den Zustand AN" Value="1" Id="%ENID%"/>
                  <Enumeration Text="ändern direkt die LED" Value="3" Id="%ENID%"/>
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-SLEDPrioControl" Name="SLEDPrioControl">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="Deaktiviert" Value="0" Id="%ENID%"/>
                  <Enumeration Text="aktiv bei 1" Value="1" Id="%ENID%"/>
                  <Enumeration Text="aktiv bei 0" Value="3" Id="%ENID%"/>
                </TypeRestriction>
              </ParameterType>
            </ParameterTypes>
            <Parameters>
              <Union SizeInBit="32">
                <Memory CodeSegment="%AID%_RS-04-00000" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00001" Name="VisibleChannels"        Offset="0" BitOffset="0" ParameterType="%AID%_PT-SLEDNumChannels"  Text="Verfügbare Kanäle" Value="%SLED_NumChannelsDefault%" SuffixText=" von %N%" />
              </Union>
            </Parameters>
            <ParameterRefs>
              <ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000101" RefId="%AID%_UP-%TT%00001" />
            </ParameterRefs>
            <ComObjectTable>
            </ComObjectTable>
            <ComObjectRefs>
            </ComObjectRefs>
          </Static>
          <Dynamic>
            <Channel Id="%AID%_CH-%PREFIX%" Number="%PREFIX%" Name="Main" Text="Status LEDs" HelpContext="SLED-Dokumentation" Icon="led-on">
              <ParameterBlock Id="%AID%_PB-nnn" Name="Basic" Text="Allgemein" Icon="cog-outline" HelpContext="SLED-Dokumentation">
                <!-- Version -->                                
                <ParameterSeparator Id="%AID%_PS-nnn" Text="StatusLED" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

                <!-- Verfuegbare-Kanaele -->
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" />

              </ParameterBlock>

              <op:include href="StatusLED.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/*" type="template" prefix="SLED" IsInner="true" />

              <!-- followed by all channels -->
              <choose ParamRefId="%AID%_UP-%TT%00001_R-%TT%0000101">
                <when test="&lt;%N%">
                  <ParameterBlock Id="%AID%_PB-nnn" Name="fAdditionalChannels" Text="(mehr)" Icon="dots-horizontal" HelpContext="Empty">
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" />
                  </ParameterBlock>
                </when>
              </choose>
            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>