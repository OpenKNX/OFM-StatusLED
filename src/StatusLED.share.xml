<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <op:config name="%SLED_NumChannelsDefault%" value="%N%" />
  <op:config name="%SLED_ShowInputSelector%" value="1" />
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <ParameterTypes>
              <ParameterType Id="%AID%_PT-SLEDNumChannels" Name="SLEDNumChannels">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="%N%" />
              </ParameterType>

              <ParameterType Id="%AID%_PT-SLEDInputs" Name="SLEDInputs">
                <TypeRestriction Base="Value" SizeInBit="16">
                  <Enumeration Text="Externes KO" Value="0" Id="%ENID%" DisplayOrder="0" />
                </TypeRestriction>
              </ParameterType>

              <ParameterType Id="%AID%_PT-SLEDMode" Name="SLEDMode">
                <TypeRestriction Base="Value" SizeInBit="16">
                  <Enumeration Text="Deaktviert" Value="0" Id="%ENID%" DisplayOrder="0"/>
                  <Enumeration Text="StatusLED" Value="1" Id="%ENID%" DisplayOrder="1"/>
                </TypeRestriction>
              </ParameterType>
            </ParameterTypes>

            <Parameters>
              <Union SizeInBit="32">
                <Parameter Id="%AID%_UP-%TT%00001" Name="VisibleChannels"        Offset="0" BitOffset="0" ParameterType="%AID%_PT-SLEDNumChannels"  Text="Verfügbare Kanäle" Value="%SLED_NumChannelsDefault%" SuffixText=" von %N%" />
              </Union>
            </Parameters>

            <ParameterRefs>
              <ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000101" RefId="%AID%_UP-%TT%00001" />
            </ParameterRefs>
            <ComObjectTable>
            </ComObjectTable>
            <ComObjectRefs>
            </ComObjectRefs>
          </Static>
          <Dynamic>
            <Channel Id="%AID%_CH-%PREFIX%" Number="%PREFIX%" Name="Main" Text="Status LEDs" HelpContext="SLED-Dokumentation" Icon="button-pointer">
              <ParameterBlock Id="%AID%_PB-nnn" Name="Basic" Text="Allgemein" Icon="cog-outline" HelpContext="SLED-Dokumentation">
                <!-- Hidden -->
                <ParameterRefRef RefId="%AID%_P-%TT%00002_R-%TT%0000201" />

                <!-- Version -->                                
                <ParameterSeparator Id="%AID%_PS-nnn" Text="StatusLED" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

                <!-- Verfuegbare-Kanaele -->
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%0001_R-%TT%0000101" HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" />

              </ParameterBlock>

              <op:include href="StatusLED.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/*" type="template" prefix="SLED" IsInner="true" />

              <!-- followed by all channels -->
              <choose ParamRefId="%AID%_UP-%TT%00001_R-%TT%0000101">
                <when test="&lt;%N%">
                  <ParameterBlock Id="%AID%_PB-nnn" Name="fAdditionalChannels" Text="(mehr)" Icon="dots-horizontal" HelpContext="Empty">
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" />
                  </ParameterBlock>
                </when>
              </choose>
            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>